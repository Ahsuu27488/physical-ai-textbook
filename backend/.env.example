# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
OPENAI_API_KEY=
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kinemata_course
NEON_DATABASE_URL=
SECRET_KEY=

# Chat & generation models (primary engine: OpenAI GPT-6 Luna, D-034)
CHAT_MODEL=gpt-6-luna
CHAT_FALLBACK_MODEL=gpt-5.6-luna,gpt-5-mini
CHAT_REASONING_EFFORT=none

# Embeddings (Gemini 3072-d for Qdrant course retrieval)
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=3072

CHAT_RATE_LIMIT_PER_MIN=20
CHAT_DAILY_LIMIT_PER_USER=150
FRONTEND_URL=http://localhost:3000
ADDITIONAL_CORS_ORIGIN=

# Password reset by email (off when MAIL_API_KEY is empty). Brevo: verify one sender address, no domain needed.
MAIL_PROVIDER=brevo
MAIL_API_KEY=
MAIL_FROM=Kinemata <you@example.com>
