# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kinemata_course
NEON_DATABASE_URL=
SECRET_KEY=

# optional (defaults: Gemini free tier, D-020)
CHAT_MODEL=gemini-3.8-flash
CHAT_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=3072
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_DAILY_LIMIT_PER_USER=150
FRONTEND_URL=http://localhost:3000
ADDITIONAL_CORS_ORIGIN=
